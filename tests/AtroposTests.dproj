        <DCCReference Include="src\Atropos.Tests.DprojParser.pas"/>
        <DCCReference Include="..\src\Adapters\DelphiAST\Atropos.Adapters.DelphiAST.pas"/>
        <DCCReference Include="src\Atropos.Tests.DelphiASTAdapter.pas"/>
        <DCCReference Include="src\Atropos.Tests.CompilerDirectives.pas"/>
        <DCCReference Include="..\src\Adapters\FileSystem\Atropos.Adapters.FileSystem.pas"/>
        <DCCReference Include="src\Atropos.Tests.FileSystem.pas"/>
        <DCCReference Include="..\src\Core\Services\Atropos.Core.Modifier.pas"/>
        <DCCReference Include="src\Atropos.Tests.Modifier.pas"/>
        <DCCReference Include="..\src\Adapters\ReportGenerator\Atropos.Adapters.ReportGenerator.pas"/>
        <DCCReference Include="src\Atropos.Tests.ReportGenerator.pas"/>
        <DCCReference Include="..\src\Adapters\ExternalUnitResolver\Atropos.Adapters.ExternalUnitResolver.pas"/>
        <DCCReference Include="src\Atropos.Tests.ExternalResolver.pas"/>
        <DCCReference Include="src\Atropos.Tests.Integration.pas"/>
        <DCCReference Include="..\src\Application\Atropos.Application.AppService.pas"/>
        <DCCReference Include="..\src\Adapters\BuildService\Atropos.Adapters.BuildService.pas"/>
        <DCCReference Include="src\Atropos.Tests.BuildReliability.pas"/>
        <DCCReference Include="src\Atropos.Tests.ProjectResolution.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">AtroposTests.dpr</Source>
                </Source>
                <Excluded_Packages>
                    <Excluded_Packages Name="$(BDSBIN)\dcloffice2k290.bpl">Microsoft Office 2000 Sample Automation Server Wrapper Components</Excluded_Packages>
                    <Excluded_Packages Name="$(BDSBIN)\dclofficexp290.bpl">Microsoft Office XP Sample Automation Server Wrapper Components</Excluded_Packages>
                </Excluded_Packages>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
