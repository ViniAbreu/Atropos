<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{6D55F05F-219C-425E-A46E-AD0896B7B327}</ProjectGuid>
        <MainSource>Probe.dpr</MainSource>
        <ProjectName>Probe</ProjectName>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>20.1</ProjectVersion>
        <ImportEnvOptions>false</ImportEnvOptions>
        <DelphiLibraryPath>$(BDS)\lib\$(Platform)\release</DelphiLibraryPath>
        <DCC_DcuOutput>bin\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>bin\$(Platform)\$(Config)</DCC_ExeOutput>
        <ProjectName Condition="'$(ProjectName)'==''">Probe</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_ConsoleTarget>true</DCC_ConsoleTarget>
        <DCC_UnitSearchPath>..\..\third_party\DelphiAST\Source;..\..\third_party\DelphiAST\Source\SimpleParser;..\..\src\Core\Ports;..\..\src\Core\Domain;..\..\src\Core\Services;..\..\src\Adapters\DelphiAST;..\..\src\Adapters\ExternalUnitResolver;src;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_IncludePath>..\..\third_party\DelphiAST\Source\SimpleParser;..\..\third_party\DelphiAST\Source;$(DCC_IncludePath)</DCC_IncludePath>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <SanitizedProjectName>Probe</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug'">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release'">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
